APP_NAME="Support Desk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production: never ship debug on; secrets live only in the real .env.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://support.example.com
# SESSION_SECURE_COOKIE=true   (default true when APP_ENV=production)
# LOG_LEVEL=warning

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error tracker (admin page /admin/errors). The stack always includes it.
# ERROR_TRACKER_LEVEL: lowest log level stored (error, warning, ...).
ERROR_TRACKER_ENABLED=true
ERROR_TRACKER_LEVEL=error
ERROR_TRACKER_TRACK_HTTP=true
ERROR_TRACKER_RETENTION_DAYS=30

# Raw log files at /admin/log-viewer (opcodesio/log-viewer, admins only).
# Its API trusts the session only for requests from APP_URL's host:port; list
# any other host the app is served on (comma separated), e.g. localhost:8001.
LOG_VIEWER_ENABLED=true
# LOG_VIEWER_API_STATEFUL_DOMAINS=

# Primary database: MySQL 8 (MariaDB 10.3+ also works with the mysql driver)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=support_desk
DB_USERNAME=root
DB_PASSWORD=

# Test database (see README "Testing"). DB_TEST_CONNECTION: auto | mysql | sqlite
# auto = use MySQL if the database below is reachable, otherwise SQLite in-memory.
DB_TEST_CONNECTION=auto
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
DB_TEST_DATABASE=support_desk_testing
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Local defaults need only MySQL. Production: QUEUE_CONNECTION=redis and CACHE_STORE=redis.
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=support_desk_cache_

MEMCACHED_HOST=127.0.0.1

# predis is pure PHP (no extension needed); use phpredis where the extension is installed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=support_desk_
REDIS_QUEUE=default

# Local: mails are written to storage/logs/laravel.log
MAIL_MAILER=log
# Production (SMTP):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps            # or smtp (STARTTLS negotiated automatically on 587)
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=465                # 587 for STARTTLS
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD=your-smtp-password
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Support desk business settings (config/support.php) ---
SUPPORT_TICKET_PREFIX=TKT
SUPPORT_TICKET_NUMBER_PADDING=6
SUPPORT_TIMEZONE=Asia/Dhaka
SUPPORT_BUSINESS_START=09:00
SUPPORT_BUSINESS_END=18:00
SUPPORT_SLA_LOW=2880
SUPPORT_SLA_MEDIUM=1440
SUPPORT_SLA_HIGH=480
SUPPORT_SLA_CRITICAL=120
SUPPORT_SLA_WARNING_THRESHOLD=0.8
SUPPORT_ATTACHMENTS_DISK=private
SUPPORT_ATTACHMENTS_MAX_KB=5120
SUPPORT_ATTACHMENTS_MAX_FILES=5
SUPPORT_ASSIGNMENT_STRATEGY=least_workload
SUPPORT_ASSIGNMENT_AUTO_ON_CREATE=true
SUPPORT_ASSIGNMENT_RETRY_BATCH=100

# Escalation and maintenance
SUPPORT_ESCALATION_LEVEL2_AFTER_MINUTES=120
SUPPORT_AUTO_CLOSE_RESOLVED_DAYS=3
SUPPORT_PRUNE_READ_NOTIFICATIONS_DAYS=90

# Rate limits (requests per minute per user)
SUPPORT_RATE_TICKETS=10
SUPPORT_RATE_REPLIES=30
SUPPORT_RATE_DOWNLOADS=60
SUPPORT_RATE_IMPORTS=5

# CSV import (long-running queue connection; see config/queue.php)
# Production: imports-redis
SUPPORT_IMPORT_QUEUE_CONNECTION=imports-database
SUPPORT_IMPORT_CHUNK_SIZE=500
SUPPORT_IMPORT_MAX_KB=51200
SUPPORT_IMPORT_WELCOME_NEW_CUSTOMERS=false
